[Unit]
Description=EFB local manager (run from source)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Use the SAME Linux user and Python interpreter as the existing EFB.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/efb-manager
# Replace /usr/bin/python3 if the original EFB uses a different interpreter.
ExecStart=/usr/bin/python3 -m efb_manager.server --profile default --port 8765
# If set for the original EFB, copy the SAME EFB_DATA_PATH and proxy values.
# Environment=EFB_DATA_PATH=/home/YOUR_USER/.ehforwarderbot
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
