[Unit]
Description=EFB local manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Replace all YOUR_USER / PATH_TO_VENV values before installation.
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER
ExecStart=/PATH_TO_VENV/bin/efb-manager --profile default --port 8765
# If the original EFB service used EFB_DATA_PATH, use that SAME value here:
# Environment=EFB_DATA_PATH=/home/YOUR_USER/.ehforwarderbot
# Copy proxy environment settings from the original EFB service if needed.
Restart=on-failure
RestartSec=5
TimeoutStopSec=25
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
